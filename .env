# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Model Configuration - Updated to GPT-5
SELF_RAG_MODEL=gpt-5
SELF_RAG_TEMPERATURE=0

# Knowledge Graph Configuration
RECREATE=0
KNOWLEDGE_GRAPH_DIR=knowledge_graph
USE_KNOWLEDGE_GRAPH=true

# Self-RAG Configuration
SELF_RAG_SEARCH_K=10
SELF_RAG_FETCH_K=30
SELF_RAG_SCORE_THRESHOLD=0.4
SELF_RAG_MAX_CONTEXT_CHUNKS=10
SELF_RAG_MAX_ROUNDS=2

# Vector Store Configuration
VECTORDB_DIR=vectordb
PDF_DIR=downloaded_pdfs

# Knowledge Graph Parameters
KG_ENTITY_EXTRACTION_MODEL=gpt-5
KG_RELATION_EXTRACTION_MODEL=gpt-5
KG_MAX_ENTITIES_PER_CHUNK=20
KG_MAX_RELATIONS_PER_CHUNK=15